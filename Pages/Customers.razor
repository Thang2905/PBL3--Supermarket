@page "/accounts"
@* @inject HttpClient Http *@
@inject Admin.Services.AuthorizedHttpClient Http
@using Admin.Models

<PageTitle>Tài khoản</PageTitle>

<h3>Danh sách tài khoản</h3>

@if (customers == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex justify-content-start mb-2">
        <button class="btn btn-success" @onclick="AddCustomer">+ Thêm tài khoản mới</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Phone</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in customers)
            {
                <tr>
                    <td>@customer.Username</td>
                    <td>@customer.Email</td>
                    <td>@customer.Phone</td>
                    <td>@customer.FirstName</td>
                    <td>@customer.LastName</td>
                    <td>
                        <button class="btn btn-info btn-sm" @onclick="() => ViewDetails(customer.Id)">Details</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteCustomer(customer.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Modal: Thêm, chi tiết và chỉnh sửa -->
@if (selectedCustomer != null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@modalTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (isEditing)
                    {
                        <div class="col-md-6 mb-3">
                            <label>Tên đăng nhập:</label>
                            <input class="form-control" @bind="selectedCustomer.Username" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Mật khẩu:</label>
                            <input class="form-control" @bind="selectedCustomer.Password" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Email:</label>
                            <input class="form-control" @bind="selectedCustomer.Email" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Số điện thoại:</label>
                            <input class="form-control" @bind="selectedCustomer.Phone" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Địa chỉ:</label>
                            <input class="form-control" @bind="selectedCustomer.Address" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Họ:</label>
                            <input class="form-control" @bind="selectedCustomer.FirstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Tên:</label>
                            <input class="form-control" @bind="selectedCustomer.LastName" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Ngày sinh:</label>
                            <input class="form-control" type="date" @bind="selectedCustomer.BirthDate" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Ngày tạo tài khoản:</label>
                            <input class="form-control" type="date" @bind="selectedCustomer.CreatedDate" />
                        </div>
                        <div class="mb-3">
                            <label>Điểm tích lũy:</label>
                            <input type="number" class="form-control" @bind="selectedCustomer.Point" />
                        </div>
                    }
                    else
                    {
                        <p><strong>ID:</strong> @selectedCustomer.Id</p>
                        <p><strong>Tên đăng nhập:</strong> @selectedCustomer.Username</p>
                        <p><strong>Email:</strong> @selectedCustomer.Email</p>
                        <p><strong>SĐT:</strong> @selectedCustomer.Phone</p>
                        <p><strong>Địa chỉ:</strong> @selectedCustomer.Address</p>
                        <p><strong>Họ:</strong> @selectedCustomer.FirstName</p>
                        <p><strong>Tên:</strong> @selectedCustomer.LastName</p>
                        <p><strong>Ngày sinh:</strong> @selectedCustomer.BirthDate</p>
                        <p><strong>Ngày tạo tài khoản:</strong> @selectedCustomer.CreatedDate</p>
                        <p><strong>Điểm tích lũy:</strong> @selectedCustomer.Point</p>
                    }
                </div>
                <div class="modal-footer">
                    @if (isEditing)
                    {
                        <button class="btn btn-primary" @onclick="SaveCustomer">Lưu</button>
                    }
                    <button class="btn btn-secondary" @onclick="CloseModal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<Customer>? customers;

    private Customer? selectedCustomer;
    private string modalTitle = "";
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Gọi API login
            bool isLoggedIn = await Http.LoginAsync("admin", "admin");
            if (!isLoggedIn)
            {
                Console.WriteLine("Login failed");
                return;
            }

            // Nếu login thành công, gọi lấy danh sách customer
            await LoadCustomer();
            
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
    }

    private async Task LoadCustomer()
    {
        var response = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:8080/supermarket/customer");
        if (response?.Code == 1000)
        {
            customers = response.Result;
        }
        else
        {
            // Handle error case here, e.g., show a message to the user
            Console.WriteLine($"Error: {response?.Message}");
        }
    }

    private void AddCustomer()
    {
        selectedCustomer = new Customer();
        modalTitle = "Thêm tài khoản khách hàng mới";
        isEditing = true;
    }

    private async Task ViewDetails(Guid id)
    {
        // Gọi API login
        bool isLoggedIn = await Http.LoginAsync("admin", "admin");
        if (!isLoggedIn)
        {
            Console.WriteLine("Login failed");
            return;
        }

        // Nếu login thành công, gọi lấy danh sách customer
        var response = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:8080/supermarket/customer");
        if (response?.Code == 1000)
        {
            customers = response.Result;
        }
        else
        {
            // Handle error case here, e.g., show a message to the user
            Console.WriteLine($"Error: {response?.Message}");
        }

        if (response != null && response.Code == 1000)
        {
            selectedCustomer = customers.FirstOrDefault(c => c.Id == id);
            modalTitle = "Chi tiết thông tin khách hàng";
            isEditing = false;
        }
    }

    private async Task SaveCustomer(){
        if (selectedCustomer == null) return;

        HttpResponseMessage response;

        bool isLoggedIn = await Http.LoginAsync("admin", "admin");
        if (!isLoggedIn)
        {
            Console.WriteLine("Login failed");
            return;
        }

        var body = new
        {
            username = selectedCustomer.Username,
            password = selectedCustomer.Password,
            email = selectedCustomer.Email,
            phone = selectedCustomer.Phone,
            address = selectedCustomer.Address,
            firstName = selectedCustomer.FirstName,
            lastName = selectedCustomer.LastName,
            birthDate = selectedCustomer.BirthDate,
            createdDate = selectedCustomer.CreatedDate,
            points = selectedCustomer.Point,
        };

        // Gọi POST API để tạo mới
        response = await Http.PostAsJsonAsync("http://localhost:8080/supermarket/customer/create", body);

        if (response.IsSuccessStatusCode)
        {
            await LoadCustomer(); // reload danh sách
            CloseModal();         // đóng modal
        }
        else
        {
            var content = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Lỗi: {content}");
        }
    }

    private async Task DeleteCustomer(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa tài khoản ID {id}?");
        if (!confirmed) return;

        bool isLoggedIn = await Http.LoginAsync("admin", "admin");
        if (!isLoggedIn)
        {
            Console.WriteLine("Login failed");
            return;
        }

        var response = await Http.DeleteAsync($"http://localhost:8080/supermarket/customer/{id}");
        if (response.IsSuccessStatusCode)
        {
            customers.RemoveAll(p => p.Id == id); // Xóa khỏi danh sách
        }
        else
        {
            Console.WriteLine("Lỗi! Không thể tài khoản.");
        }
    }

    private void CloseModal()
    {
        selectedCustomer = null;
        isEditing = false;
    }

    [Inject] IJSRuntime JS { get; set; } = default!;

    public class ApiResponse
    {
        public int Code { get; set; }
        public string Message { get; set; } = string.Empty;
        public List<Customer> Result { get; set; } = new List<Customer>();
    }

    public class ApiResponseSingle<T>
    {
        public int Code { get; set; }
        public string Message { get; set; } = string.Empty;
        public T Result { get; set; } = default!;
    }
}